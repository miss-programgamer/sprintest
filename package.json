{
	"name": "sprintest",
	"displayName": "Sprintest",
	"description": "Run your tests, no more no less!",
	"version": "0.2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/miss-programgamer/sprintest.git"
	},
	"keywords": [
		"test",
		"testing"
	],
	"type": "module",
	"types": "index.d.ts",
	"main": "bin/index.js",
	"bin": {
		"sprintest": "bin/index.js"
	},
	"files": [
		"bin/*.js",
		"./index.d.ts"
	],
	"scripts": {
		"build": "tsc -b",
		"watch": "tsc -b --watch",
		"clean": "tsc -b --clean",
		"test": "sprintest",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/argparse": "^2.0.17",
		"@types/chai": "^5.0.1",
		"@types/node": "^22.13.10",
		"@types/picomatch": "^3.0.2",
		"chai": "^5.2.0",
		"typescript": "5.8"
	},
	"dependencies": {
		"esbuild": "^0.25.0",
		"jsonschema": "^1.5.0",
		"mimicli": "^0.1.0",
		"picomatch": "^4.0.2"
	}
}