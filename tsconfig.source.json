{
	"compilerOptions": {
		"composite": true,
		"rootDir": "source",
		"outDir": "bin",
		"strict": true,
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"esModuleInterop": true,
		"tsBuildInfoFile": "bin/source.tsbuildinfo",
	},
	"include": [
		"source/**/*.ts"
	]
}